{
  "name": "tower-defense-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "data:check": "node_modules/.bin/esbuild tools/audit-data.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=node_modules/.cache/audit.mjs && FAST=1 node node_modules/.cache/audit.mjs",
    "data:check:full": "node_modules/.bin/esbuild tools/audit-data.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=node_modules/.cache/audit.mjs && node node_modules/.cache/audit.mjs",
    "check:openings": "node_modules/.bin/esbuild tools/check-openings.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=node_modules/.cache/openings.mjs && node node_modules/.cache/openings.mjs",
    "test:vocal": "node_modules/.bin/esbuild tools/vocal-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/vocal-test.mjs --external:@anthropic-ai/sdk --log-level=warning && node node_modules/.cache/vocal-test.mjs",
    "typecheck": "tsc --noEmit",
    "fixtures": "node_modules/.bin/esbuild tools/make-fixture.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/make-fixture.mjs --log-level=warning && node node_modules/.cache/make-fixture.mjs",
    "test:ui": "npm run fixtures && npm run build && node tools/ui-test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
