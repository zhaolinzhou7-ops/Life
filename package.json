{
  "name": "tower-defense-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "data:check": "node_modules/.bin/esbuild tools/audit-data.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=node_modules/.cache/audit.mjs && FAST=1 node node_modules/.cache/audit.mjs",
    "data:check:full": "node_modules/.bin/esbuild tools/audit-data.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=node_modules/.cache/audit.mjs && node node_modules/.cache/audit.mjs",
    "check:openings": "node_modules/.bin/esbuild tools/check-openings.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=node_modules/.cache/openings.mjs && node node_modules/.cache/openings.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:ui": "node tests/ui/screens.mjs",
    "test:ui:coach": "node tests/ui/coach-flow.mjs",
    "test:ui:entries": "node tests/ui/entries.mjs",
    "test:ui:naming": "node tests/ui/naming.mjs",
    "dd:sim": "node_modules/.bin/esbuild tools/doudizhu-sim.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ddsim.mjs && node node_modules/.cache/ddsim.mjs",
    "test:ui:doudizhu": "node tests/ui/doudizhu.mjs",
    "test:ui:deep": "node tests/ui/deep-coach.mjs",
    "test:ui:reach": "node tests/ui/reach.mjs",
    "test:ui:consistency": "node tests/ui/coach-consistency.mjs",
    "test:ui:side": "node tests/ui/side-and-hint.mjs",
    "test:ui:endgame": "node tests/ui/endgame-coach.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  }
}
